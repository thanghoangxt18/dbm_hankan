<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- addons\custom_quotation\views\new_template.xml -->
    <template id="new_template_portal_template" name="New Template Portal Template">
        <t t-call="portal.portal_layout">
            <t t-set="wrapwrap_classes" t-value="'o_portal_bg_dark'" />
            <!-- Inline CSS -->
            <style type="text/css">
                .portal-layout { font-family: 'MS Gothic', 'Hiragino Kaku Gothic Pro', 'Yu Gothic',
                monospace; font-size:8px; line-height:1.4; }
                .portal-layout table{ width:100%; border-collapse:collapse; border:2px solid #000;
                margin:10px 0; }
                .portal-layout table th{ background:#d0d0d0; border:1px solid #000; padding:8px;
                text-align:center; font-weight:bold; }
                .portal-layout table td{ border:1px solid #000; padding:8px; vertical-align:top; }
                @media print{
                .portal-layout{ -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                .d-print-none { display: none !important; }
                }
            </style>
            <div class="row o_custom_sale_order_preview_sidebar">
                <t t-call="portal.portal_record_sidebar" id="new_template_sidebar">
                    <t t-set="classes" t-value="'col-lg-4 col-xl-2 d-print-none'" />
                    <t t-set="entries">
                        <div class="d-flex flex-column gap-4 mt-3">
                            <div class="d-flex flex-column gap-2" id="new_template_sidebar_button">
                                <!-- Back & Download buttons -->
                                <div
                                    class="d-flex gap-2 flex-lg-column flex-xl-row flex-wrap o_download_pdf">
                                    <a href="#" class="btn custom-sale-order-back-btn flex-grow-1"
                                        role="button">
                                        <i class="fa fa-arrow-left" /> Back </a>
                                    <a
                                        class="btn btn-info text-white o_print_btn flex-grow-1 custom-download-portal-layout"
                                        t-attf-href="/my/orders/#{sale_order.id}/download_pdf_template?access_token=#{sale_order.access_token}"
                                        id="custom_download_new_template_portal"
                                        title="Download PDF" role="button">
                                        <i class="fa fa-download me-1" />Download </a>
                                </div>
                            </div>

                            <div class="navspy flex-grow-1 ps-0" t-ignore="true"
                                role="complementary">
                                <ul class="nav flex-column bs-sidenav"></ul>
                            </div>
                        </div>
                    </t>
                </t>

                <!-- MAIN CONTENT AREA -->
                <div id="quote_content" class="col-12 col-lg-8 col-xl-10 mt-5 mt-lg-0">
                    <!-- Render the new report layout in the portal content area -->
                    <t t-set="docs" t-value="[sale_order]" />
                    <t t-call="custom_obic_sale_order.report_new_layout" />
                </div>
            </div>
        </t>
    </template>

    <report
        id="action_report_new_template"
        model="sale.order"
        string="受注明細書"
        report_type="qweb-pdf"
        name="custom_obic_sale_order.new_template"
        file="custom_obic_sale_order.new_template"
        print_report_name="'受注明細書 - %s' % (object.name)"
    />
</odoo>