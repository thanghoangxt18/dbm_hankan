<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Related Partners Modal -->
  <record id="view_related_partners_modal_form" model="ir.ui.view">
    <field name="name">sale.order.related.partners.modal</field>
    <field name="model">sale.order</field>
    <field name="priority">999</field>
    <field name="arch" type="xml">
      <form string="受注入力.関連取引先情報" class="obic_modal_form">
        <style>
          .modal-footer { display: none !important; }
        </style>
        <sheet>
          <div class="container-fluid">
            <!-- Category tabs -->
            <div class="row mb-3">
              <div class="col-12">
                <div class="obic_category_tabs">
                  <span class="obic_tab active fw-bold">管理会社/代理店</span>
                  <span class="obic_tab">紹介先</span>
                  <span class="obic_tab">リース会社</span>
                </div>
              </div>
            </div>

            <!-- Hardcoded Information Form -->
            <div class="row mb-3">
              <div class="col-12">
                <div class="obic_info_section p-3 bg-light border rounded">
                  <div class="row mb-2">
                    <div class="col-3 text-end">
                      <strong>コード</strong>
                    </div>
                    <div class="col-9">
                      11536042
                    </div>
                  </div>

                  <div class="row mb-2">
                    <div class="col-3 text-end">
                      <strong>関連取引先名称</strong>
                    </div>
                    <div class="col-9">
                      大東建託パートナーズ㈱ 宇都宮営業所
                    </div>
                  </div>

                  <div class="row mb-2">
                    <div class="col-3 text-end">
                      <strong>郵便番号</strong>
                    </div>
                    <div class="col-9">
                      321 - 0951
                    </div>
                  </div>

                  <div class="row mb-2">
                    <div class="col-3 text-end">
                      <strong>住所1</strong>
                    </div>
                    <div class="col-9">
                      栃木県宇都宮市越戸町86-1
                    </div>
                  </div>

                  <div class="row mb-2">
                    <div class="col-3 text-end">
                      <strong>住所2</strong>
                    </div>
                    <div class="col-9">
                      &#160;
                    </div>
                  </div>

                  <div class="row mb-2">
                    <div class="col-3 text-end">
                      <strong>電話番号</strong>
                    </div>
                    <div class="col-9">
                      028 664 1834
                    </div>
                  </div>

                  <div class="row mb-2">
                    <div class="col-3 text-end">
                      <strong>FAX番号</strong>
                    </div>
                    <div class="col-9">
                      028 664 1838
                    </div>
                  </div>

                  <div class="row mb-2">
                    <div class="col-3 text-end">
                      <strong>関連先担当部署</strong>
                    </div>
                    <div class="col-9">
                      &#160;
                    </div>
                  </div>

                  <div class="row mb-2">
                    <div class="col-3 text-end">
                      <strong>関連先担当役職</strong>
                    </div>
                    <div class="col-9">
                      &#160;
                    </div>
                  </div>

                  <div class="row mb-2">
                    <div class="col-3 text-end">
                      <strong>関連先担当者名</strong>
                    </div>
                    <div class="col-9">
                      &#160;
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="row">
              <div class="col-12 text-end">
                <button name="action_dummy_button" string="検索" type="object"
                  class="btn btn-secondary me-2" disabled="1" />
                <button name="action_dummy_button" string="前ページ" type="object"
                  class="btn btn-secondary me-2" disabled="1" />
                <button name="action_dummy_button" string="次へ" type="object"
                  class="btn btn-primary me-2" />
                <button name="action_dummy_button" string="確定" type="object"
                  class="btn btn-primary me-2" disabled="1" />
                <button special="cancel" string="戻る" type="object"
                  class="btn btn-secondary" />
              </div>
            </div>
          </div>
        </sheet>
        <footer>
          <!-- Custom footer to override default Save/Discard buttons -->
        </footer>
      </form>
    </field>
  </record>

  <!-- Contract Detail Modal -->
