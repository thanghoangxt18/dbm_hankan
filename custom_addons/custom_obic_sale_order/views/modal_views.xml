            <!-- Parts Information Section -->
            <div class="row mb-3">
              <div class="col-12">
                <h5 class="mb-3">&lt;パーツ情報&gt;</h5>
                <div class="obic_info_section p-3 bg-light border rounded">
                  <!-- Row 1: 請求区分 and 保守報告書いいえ -->
