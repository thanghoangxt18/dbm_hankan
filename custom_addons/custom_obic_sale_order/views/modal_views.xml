                      &#160;
                    </div>
                    <div class="col-2 text-end">
                      <strong>担当者</strong>
                    </div>
                    <div class="col-4">
                      &#160;
                    </div>
                  </div>

                  <!-- Row 5: 内容 -->
                  <div class="row mb-2">
                    <div class="col-2 text-end">
                      <strong>内容</strong>
                    </div>
                    <div class="col-10">
                      &#160;
                    </div>
                  </div>

                  <!-- Row 6: 別注工事会社 -->
                  <div class="row mb-2">
                    <div class="col-2 text-end">
                      <strong>別注工事会社</strong>
                    </div>
                    <div class="col-10">
                      &#160;
