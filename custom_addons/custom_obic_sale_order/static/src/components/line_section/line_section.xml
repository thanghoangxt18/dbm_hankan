<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="custom_obic_sale_order.LineSection">
        <div class="card mb-3 shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h6 class="mb-0">
                    <span class="badge bg-primary me-2">
                        <t t-esc="props.index + 1"/>
                    </span>
                    <strong><t t-esc="productName"/></strong>
                </h6>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-primary" 
                            t-on-click="onEditClick"
                            title="編集">
                        <i class="fa fa-edit"/> 編集
                    </button>
                    <button class="btn btn-outline-danger" 
                            t-on-click="onDeleteClick"
                            title="削除">
                        <i class="fa fa-trash"/> 削除
                    </button>
                </div>
            </div>
            <div class="card-body">
        <!-- Row 1: Basic Info -->
                <div class="row mb-2">
                    <div class="col-md-3">
                        <small class="text-muted">受注区分:</small>
                        <div><t t-esc="props.lineData.obic_order_category || '-'"/></div>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted">外税:</small>
                        <div>
                            <t t-if="props.lineData.obic_is_tax_excluded">
                                <span class="badge bg-success">はい</span>
                            </t>
                            <t t-else="">
                                <span class="badge bg-secondary">いいえ</span>
                            </t>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted">規格:</small>
                        <div><t t-esc="props.lineData.obic_specification || '-'"/></div>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">総数:</small>
                        <div class="fw-bold text-primary">
                            <t t-esc="props.lineData.obic_quantity || 0"/>
                        </div>
                    </div>
                </div>

                <hr class="my-2"/>

        <!-- Row 2: Pricing -->
                <div class="row mb-2">
                    <div class="col-md-2">
                        <small class="text-muted">上代単価:</small>
                        <div><t t-esc="formatNumber(props.lineData.obic_list_unit_price)"/></div>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted">掛率:</small>
                        <div><t t-esc="formatNumber(props.lineData.obic_discount_rate)"/>%</div>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted">売上単価:</small>
                        <div><t t-esc="formatNumber(props.lineData.obic_sales_unit_price)"/></div>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">売上金額:</small>
                        <div class="fw-bold text-success">
                            ¥<t t-esc="formatNumber(props.lineData.obic_sales_amount)"/>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">売上消費税:</small>
                        <div class="fw-bold">
                            ¥<t t-esc="formatNumber(props.lineData.obic_sales_tax)"/>
                        </div>
                    </div>
                </div>

                <hr class="my-2"/>

        <!-- Row 3: Cost & Profit -->
                <div class="row mb-2">
                    <div class="col-md-2">
                        <small class="text-muted">発注仮単価:</small>
                        <div><t t-esc="formatNumber(props.lineData.obic_purchase_temp_unit_price)"/></div>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted">発注仮金額:</small>
                        <div><t t-esc="formatNumber(props.lineData.obic_purchase_temp_amount)"/></div>
                    </div>
                    <div class="col-md-2">
                        <small class="text-muted">倉庫:</small>
                        <div><t t-esc="props.lineData.obic_warehouse_code || '-'"/></div>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">原価金額:</small>
                        <div class="fw-bold">
                            ¥<t t-esc="formatNumber(props.lineData.obic_cost_amount)"/>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">粗利:</small>
                        <div class="fw-bold text-info">
                            ¥<t t-esc="formatNumber(props.lineData.obic_gross_profit)"/>
                        </div>
                    </div>
                </div>

        <!-- Row 4: Additional Info -->
                <t t-if="props.lineData.obic_shipping_destination or props.lineData.obic_inventory_warehouse or props.lineData.obic_line_remark">
                    <hr class="my-2"/>
                    <div class="row">
                        <div class="col-md-3">
                            <small class="text-muted">出荷先:</small>
                            <div><t t-esc="props.lineData.obic_shipping_destination || '-'"/></div>
                        </div>
                        <div class="col-md-3">
                            <small class="text-muted">在庫管理倉庫:</small>
                            <div><t t-esc="props.lineData.obic_inventory_warehouse || '-'"/></div>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">明細摘要:</small>
                            <div><t t-esc="props.lineData.obic_line_remark || '-'"/></div>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>