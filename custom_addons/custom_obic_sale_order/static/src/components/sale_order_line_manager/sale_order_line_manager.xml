<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="custom_obic_sale_order.SaleOrderLineManager">
        <div class="o_field_sale_order_line_widget">
      <!-- Loading state -->
            <t t-if="!state.isReady">
                <div class="text-center py-5">
                    <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
                    <p class="mt-3 text-muted">データを読み込んでいます...</p>
                </div>
            </t>

      <!-- Main content - only render when ready -->
            <t t-else="">
        <!-- Header với button thêm -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">
                        <i class="fa fa-list-alt"/> 受注明細 
                        <span class="badge bg-info ms-2">
                            <t t-esc="state.lines.length"/> 件
                        </span>
                    </h5>
                    <button class="btn btn-primary" 
                            t-on-click="openAddLineModal"
                            type="button">
                        <i class="fa fa-plus"/> 明細を追加
                    </button>
                </div>

        <!-- Danh sách lines dưới dạng sections -->
                <div class="order-lines-container">
                <t t-if="state.lines.length === 0">
                    <div class="alert alert-info text-center">
                        <i class="fa fa-info-circle"/> 
                        明細がありません。「明細を追加」ボタンをクリックして追加してください。
                    </div>
                </t>
                
                <t t-else="">
                    <t t-foreach="state.lines" t-as="line" t-key="line.id || line_index">
                        <LineSection 
                            lineData="line"
                            index="line_index"
                            onEdit="(index) => this.openEditLineModal(index)"
                            onDelete="(index) => this.deleteLine(index)"
                        />
                    </t>
                </t>
            </div>

        <!-- Summary section -->
            <t t-if="state.lines.length > 0">
                <div class="card bg-light mt-3">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="d-flex justify-content-between">
                                    <strong>税抜売上合計:</strong>
                                    <span class="text-success fw-bold">
                                        ¥<t t-esc="formatNumber(totalSalesAmount)"/>
                                    </span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="d-flex justify-content-between">
                                    <strong>消費税合計:</strong>
                                    <span class="fw-bold">
                                        ¥<t t-esc="formatNumber(totalSalesTax)"/>
                                    </span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="d-flex justify-content-between">
                                    <strong>合計:</strong>
                                    <span class="text-primary fw-bold fs-5">
                                        ¥<t t-esc="formatNumber(totalWithTax)"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
            </t> <!--
      End t-else for isReady check -->

      <!-- Modal rendered inline with Bootstrap structure -->
            <t t-if="state.showModal">
                <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
                    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
                        <div class="modal-content">
                            <LineModal 
                                lineData="state.currentLine"
                                mode="state.modalMode"
                                productList="state.productList"
                                onSave="(data) => this.onModalSave(data)"
                                onCancel="() => this.onModalCancel()"
                            />
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>